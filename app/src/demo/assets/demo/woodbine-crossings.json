{
 "version": 1,
 "challenge": {
  "name": "Woodbine crossings",
  "description": "Help map the street crossings around Woodbine Food Hall. At each crossing, check for the bumpy warning tiles at the curb and whether the crossing is painted, so blind and low-vision people know what to expect.",
  "instruction": "Survey the crossing at the mapped node. Sets tactile_paving=* and crossing:markings=* only when missing. No geometry changes.",
  "checkinComment": "Street Tally: street crossings near Woodbine Food Hall #StreetTallyWoodbine",
  "checkinSource": "survey"
 },
 "match": {
  "highway": "crossing"
 },
 "questions": [
  {
   "id": "tactile-paving",
   "prompt": "Are there bumpy warning tiles at the curb?",
   "description": "The raised dots, usually yellow or red, at both ends of the crossing. Pick Yes only if both ends have them.",
   "expect": {
    "tactile_paving": null
   },
   "options": [
    {
     "id": "yes",
     "label": "Yes, both ends",
     "setTags": {
      "tactile_paving": "yes"
     }
    },
    {
     "id": "partial",
     "label": "Only one end",
     "setTags": {
      "tactile_paving": "partial"
     }
    },
    {
     "id": "no",
     "label": "No",
     "setTags": {
      "tactile_paving": "no"
     }
    }
   ]
  },
  {
   "id": "crossing-markings",
   "prompt": "How is the crossing painted?",
   "description": "Look at the road surface where people cross.",
   "expect": {
    "crossing:markings": null
   },
   "options": [
    {
     "id": "zebra",
     "label": "Wide stripes across",
     "setTags": {
      "crossing:markings": "zebra"
     }
    },
    {
     "id": "lines",
     "label": "Two lines along the edges",
     "setTags": {
      "crossing:markings": "lines"
     }
    },
    {
     "id": "ladder",
     "label": "Stripes and edge lines",
     "setTags": {
      "crossing:markings": "ladder"
     }
    },
    {
     "id": "no",
     "label": "No paint",
     "setTags": {
      "crossing:markings": "no"
     }
    }
   ]
  }
 ],
 "outcomes": [
  {
   "id": "no-crossing",
   "label": "There's no crossing here",
   "description": "Nobody can cross the street at this spot.",
   "status": 6
  }
 ],
