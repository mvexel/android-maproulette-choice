{
 "version": 1,
 "challenge": {
  "name": "Woodbine buildings",
  "description": "Help map the buildings around Woodbine Food Hall. For each building, count its floors and check the shape of its roof, so maps can show the neighborhood in 3D.",
  "instruction": "Survey the building at the mapped way. Sets building:levels=* and roof:shape=* only when missing. Floors count above ground, not counting the roof or attic. No geometry changes.",
  "checkinComment": "Street Tally: buildings near Woodbine Food Hall #StreetTallyWoodbine",
  "checkinSource": "survey"
 },
 "match": {},
 "matchKeys": [
  "building"
 ],
 "questions": [
  {
   "id": "levels",
   "prompt": "How many floors does it have?",
   "description": "Count floors above the ground. Don't count the roof or an attic. For a tall building, count rows of windows.",
   "expect": {
    "building:levels": null
   },
   "options": [
    {
     "id": "1",
     "label": "1 floor",
     "setTags": {
      "building:levels": "1"
     }
    },
    {
     "id": "2",
     "label": "2 floors",
     "setTags": {
      "building:levels": "2"
     }
    },
    {
     "id": "3",
     "label": "3 floors",
     "setTags": {
      "building:levels": "3"
     }
    },
    {
     "id": "4",
     "label": "4 floors",
     "setTags": {
      "building:levels": "4"
     }
    },
    {
     "id": "5",
     "label": "5 floors",
     "setTags": {
      "building:levels": "5"
     }
    },
    {
     "id": "6",
     "label": "6 floors",
     "setTags": {
      "building:levels": "6"
     }
    },
    {
     "id": "7",
     "label": "7 floors",
     "setTags": {
      "building:levels": "7"
     }
    },
    {
     "id": "8",
     "label": "8 floors",
     "setTags": {
      "building:levels": "8"
     }
    },
    {
     "id": "9",
     "label": "9 floors",
     "setTags": {
      "building:levels": "9"
     }
    },
    {
     "id": "10",
     "label": "10 floors",
     "setTags": {
      "building:levels": "10"
     }
    }
   ]
  },
  {
   "id": "roof-shape",
   "prompt": "What shape is the roof?",
   "description": "Look from across the street if you can.",
   "expect": {
    "roof:shape": null
   },
   "options": [
    {
     "id": "flat",
     "label": "Flat",
     "setTags": {
      "roof:shape": "flat"
     }
    },
    {
     "id": "gabled",
     "label": "Two slopes, like a tent",
     "setTags": {
      "roof:shape": "gabled"
     }
    },
    {
     "id": "hipped",
     "label": "Four slopes",
     "setTags": {
      "roof:shape": "hipped"
     }
    },
    {
     "id": "skillion",
     "label": "One slope",
     "setTags": {
      "roof:shape": "skillion"
     }
    },
    {
     "id": "pyramidal",
     "label": "Pointed, four sides",
     "setTags": {
      "roof:shape": "pyramidal"
     }
    },
    {
     "id": "gambrel",
     "label": "Barn-shaped",
     "setTags": {
      "roof:shape": "gambrel"
     }
    },
    {
     "id": "round",
     "label": "Curved",
     "setTags": {
      "roof:shape": "round"
     }
    }
   ]
  }
 ],
