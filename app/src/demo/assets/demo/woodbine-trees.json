{
 "version": 1,
 "challenge": {
  "name": "Woodbine trees",
  "description": "Help map the trees around Woodbine Food Hall. At each tree, check whether it has leaves or needles. It takes a few seconds per tree.",
  "instruction": "Survey the tree at the mapped node. Sets leaf_type=* only when missing. No geometry changes.",
  "checkinComment": "Street Tally: trees near Woodbine Food Hall #StreetTallyWoodbine",
  "checkinSource": "survey"
 },
 "match": {
  "natural": "tree"
 },
 "questions": [
  {
   "id": "leaf-type",
   "prompt": "Does this tree have leaves or needles?",
   "description": "The tree at the big pin. Palms count as leaves.",
   "expect": {
    "leaf_type": null
   },
   "options": [
    {
     "id": "broadleaved",
     "label": "Leaves",
     "setTags": {
      "leaf_type": "broadleaved"
     }
    },
    {
     "id": "needleleaved",
     "label": "Needles",
     "setTags": {
      "leaf_type": "needleleaved"
     }
    }
   ]
  }
 ],
 "outcomes": [
  {
   "id": "no-tree",
   "label": "There's no tree here",
   "description": "The tree is gone or was never there.",
   "status": 6
  }
 ],
